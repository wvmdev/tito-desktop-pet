{
  "name": "tito-desktop-pet",
  "version": "1.0.1",
  "description": "Tito, a cozy desktop cat companion",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis zip --x64"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.08.0"
  },
  "build": {
    "appId": "com.tito.desktop",
    "productName": "Tito",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "pet-behavior.js",
      "renderer.js",
      "main.js",
      "preload.js",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.lifestyle",
      "icon": "assets/tito-icon.icns",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "assets/tito-icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
